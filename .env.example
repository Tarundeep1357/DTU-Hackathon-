# Copy to .env; never commit credentials.
EA_DATABASE_URL=sqlite:///data/evidence_arena.db
EA_STORAGE_DIR=data/sources
EA_RETENTION_DAYS=30
EA_MAX_FILES=3
EA_MAX_FILE_MB=10
EA_MAX_PDF_PAGES=20
EA_MAX_CLAIMS=5
EA_RETRIEVAL_LIMIT=6
EA_OCR_ENABLED=true
EA_OCR_LANGUAGE=eng
# Explicit allowlist; comma-separated exact hostnames. Empty disables retrieval.
EA_ALLOWED_HOSTS=
# Immutable OIDC subject IDs; get the subject from your signed-in profile.
# Format: issuer|subject, separated by commas. Avoid using email as identity.
EA_ADMIN_IDENTITIES=
GEMMA_BASE_URL=
GEMMA_MODEL_ID=
GEMMA_API_KEY=
GEMMA_TIMEOUT_SECONDS=45
GEMMA_PRIVACY_URL=
GEMMA_REMOTE=true
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_VALUE
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_VALUE
# Bind local startup to loopback. Docker exposes port 8501 on loopback by default.

